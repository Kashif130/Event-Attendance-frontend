# Default GenLayer network the app opens on: studionet | localnet | testnetAsimov | testnetBradbury
VITE_GENLAYER_NETWORK=studionet

# The deployed EventAttendance address for the default network above.
# StudioNet deployment of EventAttendance v0.3; see deploy/manifest.json for the tx hash and source hash.
VITE_CONTRACT_ADDRESS=0x68f01b081fcc59394b68f743672DeCC317d32b01

# Optional: a separate deployment per network. These win over VITE_CONTRACT_ADDRESS for that network.
# VITE_CONTRACT_ADDRESS_STUDIONET=
# VITE_CONTRACT_ADDRESS_LOCALNET=
# VITE_CONTRACT_ADDRESS_TESTNETASIMOV=
# VITE_CONTRACT_ADDRESS_TESTNETBRADBURY=
